---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TypingTitle from '../components/TypingTitle.astro';
import SqlConsole from '../components/SqlConsole.astro';
import Icon from '../components/Icon.astro';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import {
  profile,
  roles,
  about,
  experience,
  otherExperience,
  education,
  skills,
  certifications,
  formspreeId,
  speaking,
} from '../data/resume';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const allTags = [...new Set(projects.flatMap((p) => p.data.tech))].sort();

// Formats one or more "YYYY-MM-DD" dates, e.g.
// "August 13, 2026" · "August 13–15, 2026" · "August 13, 20 & 27, 2026" · "August 30 – September 2, 2026"
const formatDates = (input: string | string[]) => {
  const list = Array.isArray(input) ? input : [input];
  const ds = list.map((d) => new Date(d)).sort((a, b) => a.getTime() - b.getTime());
  if (ds.length === 0) return '';
  const opts = { timeZone: 'UTC' } as const;
  const full = (d: Date) => d.toLocaleDateString('en-PH', { ...opts, year: 'numeric', month: 'long', day: 'numeric' });
  const md = (d: Date) => d.toLocaleDateString('en-PH', { ...opts, month: 'long', day: 'numeric' });
  const first = ds[0];
  const last = ds[ds.length - 1];
  if (ds.length === 1) return full(first);

  const year = first.getUTCFullYear();
  const sameYear = ds.every((d) => d.getUTCFullYear() === year);
  const sameMonth = sameYear && ds.every((d) => d.getUTCMonth() === first.getUTCMonth());
  const consecutive = ds.every((d, i) => i === 0 || d.getTime() - ds[i - 1].getTime() === 86400000);
  const andList = (parts: string[]) => `${parts.slice(0, -1).join(', ')} & ${parts[parts.length - 1]}`;

  if (consecutive && sameMonth) return `${md(first)}–${last.getUTCDate()}, ${year}`;
  if (consecutive && sameYear) return `${md(first)} – ${md(last)}, ${year}`;
  if (sameMonth) return `${md(first)}, ${andList(ds.slice(1).map((d) => String(d.getUTCDate())))}, ${year}`;
  if (sameYear) return `${andList(ds.map(md))}, ${year}`;
  return andList(ds.map(full));
};

const countDates = (input: string | string[]) => (Array.isArray(input) ? input.length : 1);

// Tables for the SQL console — built from your resume data, so it updates automatically.
const db = {
  experience: experience.map((e) => ({ role: e.role, org: e.org, period: e.period })),
  skills: skills.flatMap((s) => s.items.map((name) => ({ name, layer: s.layer }))),
  projects: projects.map((p) => ({
    title: p.data.title,
    tech: p.data.tech.join(', '),
    year: p.data.date ? p.data.date.getFullYear() : '',
  })),
  education: education.map((e) => ({ degree: e.degree, school: e.school, year: e.period })),
  speaking: speaking.map((t) => ({ title: t.title, event: t.event, type: t.type, dates: formatDates(t.date), sessions: countDates(t.date) })),
};


const examples = [
  'SELECT * FROM experience;',
  "SELECT name FROM skills WHERE layer = 'Backend';",
  'SELECT title, tech FROM projects ORDER BY year DESC;',
  "SELECT * FROM projects WHERE tech LIKE '%MySQL%';",
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="flex flex-col-reverse items-center gap-10 py-20 sm:flex-row">
    <div class="flex-1">
      <p class="text-sm font-medium text-accent">{profile.location}</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">{profile.name}</h1>
      <TypingTitle roles={roles} />
      <p class="mt-6 max-w-xl leading-relaxed">{profile.summary}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#portfolio"
          class="rounded-md bg-accent px-4 py-2 font-medium text-white hover:opacity-90 dark:text-slate-950"
          >View portfolio</a
        >
        {
          profile.links.map((l) => (
            <a
              href={l.url}
              target="_blank"
              rel="noopener"
              class="rounded-md border border-slate-300 px-4 py-2 font-medium hover:border-accent hover:text-accent dark:border-slate-700"
            >
              {l.label}
            </a>
          ))
        }
      </div>
    </div>
    <img
      src={profile.photo}
      alt={profile.name}
      class="h-44 w-44 rounded-full bg-slate-200 object-cover ring-4 ring-accent/20 sm:h-56 sm:w-56 dark:bg-slate-800"
    />
  </section>

  <!-- SQL console -->
  <section class="reveal pb-6" aria-label="Query my resume">
    <h2 class="mb-1 text-lg font-semibold">Query my resume</h2>
    <p class="mb-4 text-sm text-slate-600 dark:text-slate-400">
      Click an example or write your own SQL.
    </p>
    <SqlConsole db={db} examples={examples} />
  </section>

  <Section id="about" title="About">
    <div class="reveal max-w-3xl space-y-4 leading-relaxed">
      {about.map((p) => <p>{p}</p>)}
    </div>
  </Section>

  <Section id="skills" title="Skills">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        skills.map((s) => (
          <div class="reveal rounded-xl bg-slate-50 p-4 dark:bg-slate-900/60 dark:backdrop-blur-sm">
            <h3 class="mb-3 flex items-center gap-2 font-semibold">
              <Icon name={s.layer} class="h-5 w-5 text-accent" />
              {s.layer}
            </h3>
            <ul class="flex flex-wrap gap-2">
              {s.items.map((i) => (
                <li class="rounded-md border border-slate-200 bg-white px-2.5 py-1 text-sm dark:border-slate-800 dark:bg-slate-950">
                  {i}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {
      certifications.length > 0 && (
        <>
          <h3 class="mb-4 mt-12 text-lg font-semibold">Certifications</h3>
          <ul class="space-y-2">
            {certifications.map((c) => (
              <li class="reveal">
                {c.url ? (
                  <a href={c.url} target="_blank" rel="noopener" class="font-medium hover:text-accent">
                    {c.name}
                  </a>
                ) : (
                  <span class="font-medium">{c.name}</span>
                )}
                <span class="text-slate-500">
                  {' '}
                  — {c.issuer}, {c.year}
                </span>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </Section>

  <Section id="portfolio" title="Portfolio">
    <div class="mb-6 flex flex-wrap gap-2" aria-label="Filter projects by technology">
      {
        ['All', ...allTags].map((t, i) => (
          <button
            type="button"
            data-filter={t}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="rounded-full border border-slate-300 px-3 py-1 text-sm transition hover:border-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-white dark:border-slate-700 dark:aria-pressed:text-slate-950"
          >
            {t}
          </button>
        ))
      }
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </Section>

  <Section id="experience" title="Experience">
    <div class="relative pl-8">
      <div class="timeline-line absolute bottom-2 left-[5px] top-2 w-0.5 bg-accent/30"></div>
      <ol class="space-y-10">
        {
          experience.map((job) => (
            <li class="reveal relative">
              <span class="absolute -left-8 top-1.5 h-3 w-3 rounded-full bg-accent ring-4 ring-white dark:ring-slate-950" />
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-semibold">{job.role}</h3>
                <span class="text-sm text-slate-500">{job.period}</span>
              </div>
              <p class="text-slate-600 dark:text-slate-400">{job.org}</p>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
                {job.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>

    {
      otherExperience.length > 0 && (
        <>
          <h3 class="mb-4 mt-12 text-lg font-semibold">Other Experience</h3>
          <div class="grid gap-4 sm:grid-cols-2">
            {otherExperience.map((job) => (
              <div class="reveal rounded-xl border border-slate-200 p-4 dark:border-slate-800 dark:bg-slate-900/60 dark:backdrop-blur-sm">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h4 class="font-semibold">{job.role}</h4>
                  <span class="text-sm text-slate-500">{job.period}</span>
                </div>
                <p class="text-slate-600 dark:text-slate-400">{job.org}</p>
                {job.points && job.points.length > 0 && (
                  <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
                    {job.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </>
      )
    }

    <h3 class="mb-4 mt-12 text-lg font-semibold">Education</h3>
    <ul class="space-y-3">
      {
        education.map((e) => (
          <li class="reveal flex flex-wrap justify-between gap-2">
            <span>
              <span class="font-medium">{e.degree}</span> — {e.school}
            </span>
            <span class="text-sm text-slate-500">{e.period}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    speaking.length > 0 && (
      <Section id="speaking" title="Speaking Engagements">
        <div class="grid gap-4 md:grid-cols-2">
          {speaking.map((talk) => (
            <article class="reveal flex flex-col overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 dark:bg-slate-900/60 dark:backdrop-blur-sm">
              {talk.photos && talk.photos.length > 0 && (
                <PhotoCarousel photos={talk.photos} alt={`${talk.title} at ${talk.event}`} />
              )}
              <div class="flex flex-1 flex-col p-5">
              <div class="flex flex-wrap items-center gap-2 text-xs">
                <span class="rounded-full bg-accent/15 px-2.5 py-0.5 font-medium text-accent">{talk.type}</span>
                <span class="text-slate-500">
                  {formatDates(talk.date)}
                  {countDates(talk.date) > 1 && <> · {countDates(talk.date)} sessions</>}
                </span>
              </div>
              <h3 class="mt-3 text-lg font-semibold">{talk.title}</h3>
              <p class="text-sm text-slate-600 dark:text-slate-400">
                {[talk.event, talk.organizer].filter(Boolean).join(' · ')}
              </p>
              {talk.location && <p class="mt-1 text-xs text-slate-500">{talk.location}</p>}
              {talk.description && <p class="mt-3 flex-1 text-sm leading-relaxed">{talk.description}</p>}
              {talk.link && (
                <a href={talk.link} target="_blank" rel="noopener" class="mt-4 text-sm font-medium text-accent hover:underline">
                  View details ↗
                </a>
              )}
              </div>
            </article>
          ))}
        </div>
      </Section>
    )
  }

  <Section id="contact" title="Contact">
    <p class="mb-6 max-w-xl">Interested in working together or have a question? Reach out.</p>
    {
      formspreeId ? (
        <form action={`https://formspree.io/f/${formspreeId}`} method="POST" class="grid max-w-xl gap-4">
          <input
            name="name"
            required
            placeholder="Your name"
            class="rounded-md border border-slate-300 bg-transparent px-3 py-2 dark:border-slate-700"
          />
          <input
            name="email"
            type="email"
            required
            placeholder="Your email"
            class="rounded-md border border-slate-300 bg-transparent px-3 py-2 dark:border-slate-700"
          />
          <textarea
            name="message"
            rows="5"
            required
            placeholder="Message"
            class="rounded-md border border-slate-300 bg-transparent px-3 py-2 dark:border-slate-700"
          ></textarea>
          <button
            type="submit"
            class="justify-self-start rounded-md bg-accent px-5 py-2 font-medium text-white hover:opacity-90 dark:text-slate-950"
          >
            Send
          </button>
        </form>
      ) : (
        <div class="flex flex-wrap gap-3">
          {profile.links.map((l) => (
            <a
              href={l.url}
              class="rounded-md border border-slate-300 px-4 py-2 hover:border-accent hover:text-accent dark:border-slate-700"
            >
              {l.label}
            </a>
          ))}
        </div>
      )
    }
  </Section>
</BaseLayout>

<script>
  // Portfolio filter: show only cards that use the selected technology.
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  filters.forEach((btn) =>
    btn.addEventListener('click', () => {
      const tag = btn.dataset.filter ?? 'All';
      filters.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
        const tags = (card.dataset.tags ?? '').split('|');
        card.hidden = tag !== 'All' && !tags.includes(tag);
      });
    }),
  );
</script>
