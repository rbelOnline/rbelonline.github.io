---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, image, tech, demo, repo, live, layers, api } = project.data;
const href = `/projects/${project.id}/`;
---

<article
  class="project-card reveal flex flex-col rounded-xl border border-slate-200 bg-white p-5 transition hover:shadow-lg dark:border-slate-800 dark:bg-slate-950/60 dark:backdrop-blur-sm"
  data-tags={tech.join('|')}
>
  <div class="flex flex-wrap items-center gap-2">
    <h3 class="text-lg font-semibold">
      <a href={href} class="hover:text-accent">{title}</a>
    </h3>
    {
      live && (
        <span class="flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400">
          <span class="h-2 w-2 rounded-full bg-emerald-500" />
          online
        </span>
      )
    }
    {
      api && (
        <div class="ml-auto flex gap-1 text-xs" role="group" aria-label="Choose view">
          <button
            type="button"
            data-view="ui"
            aria-pressed="true"
            class="rounded-md border border-slate-300 px-2.5 py-1 aria-pressed:border-accent aria-pressed:bg-accent/10 aria-pressed:text-accent dark:border-slate-700"
          >
            UI
          </button>
          <button
            type="button"
            data-view="api"
            aria-pressed="false"
            class="rounded-md border border-slate-300 px-2.5 py-1 aria-pressed:border-accent aria-pressed:bg-accent/10 aria-pressed:text-accent dark:border-slate-700"
          >
            API
          </button>
        </div>
      )
    }
  </div>

  <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{summary}</p>

  <div class="mt-4">
    <div data-panel="ui">
      {
        image && (
          <a
            href={href}
            class="block aspect-video overflow-hidden rounded-lg bg-slate-100 dark:bg-slate-900"
          >
            <img
              src={image}
              alt={`Screenshot of ${title}`}
              loading="lazy"
              class="h-full w-full object-cover transition hover:scale-105"
            />
          </a>
        )
      }
    </div>
    {
      api && (
        <pre
          data-panel="api"
          hidden
          class="aspect-video overflow-auto rounded-lg bg-slate-900 p-4 font-mono text-xs leading-relaxed text-slate-100"
        ><span class="font-semibold text-violet-300">{api.method}</span> {api.path}

{api.response.trim()}</pre>
      )
    }
  </div>

  {
    layers.length > 0 && (
      <div class="mt-4">
        <p class="mb-2 text-xs text-slate-500">How it's built · click a layer</p>
        <div class="flex items-center gap-1">
          {layers.map((layer, i) => (
            <>
              <button
                type="button"
                data-layer
                data-detail={layer.detail}
                aria-pressed={i === 0 ? 'true' : 'false'}
                class="flex min-w-0 flex-1 flex-col items-center gap-1 rounded-md border border-slate-300 px-1 py-2 text-xs transition aria-pressed:border-accent aria-pressed:bg-accent/10 aria-pressed:text-accent dark:border-slate-700"
              >
                <Icon name={layer.name} class="h-4 w-4" />
                <span class="w-full truncate text-center">{layer.name}</span>
              </button>
              {i < layers.length - 1 && (
                <span class="text-xs text-slate-400" aria-hidden="true">
                  →
                </span>
              )}
            </>
          ))}
        </div>
        <p data-layer-detail class="mt-2 min-h-10 text-sm text-slate-600 dark:text-slate-400">
          {layers[0].detail}
        </p>
      </div>
    )
  }

  <ul class="mt-4 flex flex-wrap gap-2">
    {tech.map((t) => <li class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs dark:bg-slate-800">{t}</li>)}
  </ul>

  <div class="mt-auto flex gap-4 pt-4 text-sm font-medium">
    <a href={href} class="text-accent hover:underline">Details</a>
    {demo && <a href={demo} target="_blank" rel="noopener" class="text-accent hover:underline">Live demo ↗</a>}
    {repo && <a href={repo} target="_blank" rel="noopener" class="text-accent hover:underline">Code ↗</a>}
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
    const viewButtons = card.querySelectorAll<HTMLButtonElement>('[data-view]');
    viewButtons.forEach((btn) =>
      btn.addEventListener('click', () => {
        viewButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        card.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
          panel.hidden = panel.dataset.panel !== btn.dataset.view;
        });
      }),
    );

    const detail = card.querySelector<HTMLElement>('[data-layer-detail]');
    const layerButtons = card.querySelectorAll<HTMLButtonElement>('[data-layer]');
    layerButtons.forEach((btn) =>
      btn.addEventListener('click', () => {
        layerButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        if (detail) detail.textContent = btn.dataset.detail ?? '';
      }),
    );
  });
</script>
