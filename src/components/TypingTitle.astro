---
// Cycles through your roles with a typing effect.
// Edit the roles in src/data/resume.ts.
interface Props {
  roles: string[];
}
const { roles } = Astro.props;
---

<p class="mt-3 min-h-8 text-xl text-slate-600 dark:text-slate-400" aria-label={roles.join(', ')}>
  <span data-typing={JSON.stringify(roles)} aria-hidden="true">{roles[0]}</span><span
    class="typing-cursor"
    aria-hidden="true"></span>
</p>

<script>
  const el = document.querySelector<HTMLElement>('[data-typing]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && !reduce) {
    const roles: string[] = JSON.parse(el.dataset.typing || '[]');
    if (roles.length > 1) {
      let r = 0;
      let c = roles[0].length;
      let deleting = true;

      const tick = () => {
        const text = roles[r];
        el.textContent = text.slice(0, c);
        if (!deleting && c < text.length) {
          c++;
          setTimeout(tick, 70);
        } else if (!deleting) {
          deleting = true;
          setTimeout(tick, 1800);
        } else if (c > 0) {
          c--;
          setTimeout(tick, 35);
        } else {
          deleting = false;
          r = (r + 1) % roles.length;
          setTimeout(tick, 300);
        }
      };
      setTimeout(tick, 1800);
    }
  }
</script>
