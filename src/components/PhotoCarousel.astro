---
// Swipeable photo slideshow with arrows, dots, and a full-screen viewer.
// Usage: <PhotoCarousel photos={['/images/a.jpg', '/images/b.jpg']} alt="Event name" />
interface Props {
  photos: string[];
  alt: string;
}

const { photos, alt } = Astro.props;
const many = photos.length > 1;
---

<div class="relative aspect-video bg-slate-900" data-carousel>
  <div
    class="flex h-full snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    data-track
  >
    {
      photos.map((src, i) => (
        <button
          type="button"
          class="h-full w-full shrink-0 snap-center cursor-zoom-in"
          data-open={i}
          aria-label={`View photo ${i + 1} of ${photos.length} full screen`}
        >
          <img
            src={src}
            alt={`${alt}, photo ${i + 1}`}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </button>
      ))
    }
  </div>

  {
    many && (
      <>
        <button
          type="button"
          data-prev
          aria-label="Previous photo"
          class="absolute left-2 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full bg-black/50 text-xl text-white backdrop-blur-sm hover:bg-black/70"
        >
          ‹
        </button>
        <button
          type="button"
          data-next
          aria-label="Next photo"
          class="absolute right-2 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full bg-black/50 text-xl text-white backdrop-blur-sm hover:bg-black/70"
        >
          ›
        </button>
        <span
          data-count
          class="absolute right-2 top-2 rounded-full bg-black/50 px-2 py-0.5 text-xs text-white backdrop-blur-sm"
        >
          1 / {photos.length}
        </span>
        <div class="absolute bottom-2 left-1/2 flex -translate-x-1/2 gap-1.5" aria-hidden="true">
          {photos.map((_, i) => (
            <span data-dot class={`h-1.5 w-1.5 rounded-full transition ${i === 0 ? 'bg-white' : 'bg-white/40'}`} />
          ))}
        </div>
      </>
    )
  }

  <!-- Full-screen viewer -->
  <dialog
    data-lightbox
    class="fixed inset-0 m-auto h-fit max-h-[92vh] w-fit max-w-[94vw] overflow-visible bg-transparent p-0 backdrop:bg-black/90"
  >
    <img data-lightbox-img alt="" class="max-h-[88vh] max-w-[94vw] rounded-lg object-contain" />
    <p data-lightbox-count class="mt-2 text-center text-sm text-slate-300"></p>
    <button
      type="button"
      data-close
      aria-label="Close"
      class="absolute -top-3 -right-3 flex h-9 w-9 items-center justify-center rounded-full bg-white text-lg text-slate-900 shadow hover:bg-slate-200"
    >
      ✕
    </button>
    {
      many && (
        <>
          <button
            type="button"
            data-lb-prev
            aria-label="Previous photo"
            class="absolute left-2 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-2xl text-white hover:bg-black/80"
          >
            ‹
          </button>
          <button
            type="button"
            data-lb-next
            aria-label="Next photo"
            class="absolute right-2 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-2xl text-white hover:bg-black/80"
          >
            ›
          </button>
        </>
      )
    }
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const sources = slides.map((s) => s.querySelector('img')?.getAttribute('src') ?? '');
    const alts = slides.map((s) => s.querySelector('img')?.getAttribute('alt') ?? '');
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const count = root.querySelector<HTMLElement>('[data-count]');
    const total = slides.length;
    let current = 0;

    // --- Slideshow on the card ---
    const update = () => {
      dots.forEach((d, k) => {
        d.classList.toggle('bg-white', k === current);
        d.classList.toggle('bg-white/40', k !== current);
      });
      if (count) count.textContent = `${current + 1} / ${total}`;
    };

    const goTo = (i: number) => {
      current = (i + total) % total;
      track.scrollTo({ left: current * track.clientWidth, behavior: 'smooth' });
      update();
    };

    track.addEventListener(
      'scroll',
      () => {
        const i = Math.round(track.scrollLeft / track.clientWidth);
        if (i !== current) {
          current = i;
          update();
        }
      },
      { passive: true },
    );

    root.querySelector('[data-prev]')?.addEventListener('click', () => goTo(current - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => goTo(current + 1));

    // --- Full-screen viewer ---
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const big = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const bigCount = dialog.querySelector<HTMLElement>('[data-lightbox-count]')!;
    let shown = 0;

    const show = (i: number) => {
      shown = (i + total) % total;
      big.src = sources[shown];
      big.alt = alts[shown];
      bigCount.textContent = total > 1 ? `${shown + 1} / ${total}` : '';
    };

    slides.forEach((slide, i) =>
      slide.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      }),
    );

    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(shown - 1));
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => show(shown + 1));

    // Click outside the photo closes; arrow keys flip photos.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(shown - 1);
      if (e.key === 'ArrowRight') show(shown + 1);
    });

    // When the viewer closes, keep the card on the photo that was last viewed.
    dialog.addEventListener('close', () => goTo(shown));
  });
</script>
