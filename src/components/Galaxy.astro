---
// Animated galaxy background: a slowly drifting, twinkling starfield on deep purple,
// with a gentle parallax when scrolling. Optional nebula glows and shooting stars.
// Visitors with "reduce motion" turned on get a still image instead.
---

<canvas id="galaxy" class="pointer-events-none fixed inset-0 -z-10 h-full w-full" aria-hidden="true"
></canvas>

<script>
  type Star = { x: number; y: number; r: number; a: number; speed: number; dir: number; depth: number; tint: string };
  type Shooting = { x: number; y: number; vx: number; vy: number; life: number };

  const canvas = document.getElementById('galaxy') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Tweak these to change the look.
    const SKY = '#030014'; // deep space purple
    const STAR_TINTS = ['255,255,255', '255,255,255', '255,255,255', '221,214,254', '196,181,253'];
    const STAR_DENSITY = 5000; // higher = fewer stars
    const DRIFT_SPEED = 0.06; // how fast the starfield slowly drifts
    const SHOOTING_STARS = false; // set to true for occasional shooting stars
    // Soft colored glows. Add entries for a "nebula" look,
    // e.g. { x: 0.2, y: 0.25, r: 0.55, color: '124,58,237', alpha: 0.2 }
    const NEBULAE = [
      { x: 0.5, y: 0, r: 0.6, color: '76,29,149', alpha: 0.18 }, // faint violet glow at the top
    ];

    let w = 0;
    let h = 0;
    let stars: Star[] = [];
    let shooting: Shooting | null = null;
    let running = true;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.min(Math.round((w * h) / STAR_DENSITY), 600);
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() ** 3 * 1.3 + 0.3,
        a: Math.random(),
        speed: Math.random() * 0.015 + 0.003,
        dir: Math.random() < 0.5 ? 1 : -1,
        depth: Math.random(),
        tint: STAR_TINTS[Math.floor(Math.random() * STAR_TINTS.length)],
      }));
    };

    const draw = (t: number) => {
      ctx.fillStyle = SKY;
      ctx.fillRect(0, 0, w, h);

      // Nebula clouds drift slowly.
      for (const [i, n] of NEBULAE.entries()) {
        const x = (n.x + Math.sin(t / 22000 + i * 2) * 0.04) * w;
        const y = (n.y + Math.cos(t / 26000 + i) * 0.04) * h;
        const r = n.r * Math.max(w, h);
        const g = ctx.createRadialGradient(x, y, 0, x, y, r);
        g.addColorStop(0, `rgba(${n.color},${n.alpha})`);
        g.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, w, h);
      }

      // Stars twinkle; nearer stars move a little more when you scroll.
      const scroll = window.scrollY;
      for (const s of stars) {
        if (!reduceMotion) {
          s.a += s.speed * s.dir;
          if (s.a > 1 || s.a < 0.15) s.dir *= -1;
          // Slow drift up and to the left; nearer stars drift a bit faster.
          const v = DRIFT_SPEED * (0.3 + s.depth);
          s.x = (s.x - v + w) % w;
          s.y = (s.y - v * 0.5 + h) % h;
        }
        const y = (((s.y - scroll * (0.05 + s.depth * 0.15)) % h) + h) % h;
        ctx.globalAlpha = Math.max(0.15, Math.min(1, s.a));
        ctx.fillStyle = `rgb(${s.tint})`;
        ctx.beginPath();
        ctx.arc(s.x, y, s.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;

      // Occasional shooting star.
      if (!reduceMotion && SHOOTING_STARS) {
        if (!shooting && Math.random() < 0.003) {
          shooting = {
            x: Math.random() * w * 0.7 + w * 0.2,
            y: Math.random() * h * 0.4,
            vx: -(6 + Math.random() * 4),
            vy: 3 + Math.random() * 2,
            life: 1,
          };
        }
        if (shooting) {
          const s = shooting;
          const tail = ctx.createLinearGradient(s.x, s.y, s.x - s.vx * 14, s.y - s.vy * 14);
          tail.addColorStop(0, `rgba(255,255,255,${s.life})`);
          tail.addColorStop(1, 'rgba(255,255,255,0)');
          ctx.strokeStyle = tail;
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.moveTo(s.x, s.y);
          ctx.lineTo(s.x - s.vx * 14, s.y - s.vy * 14);
          ctx.stroke();
          s.x += s.vx;
          s.y += s.vy;
          s.life -= 0.012;
          if (s.life <= 0 || s.x < -100 || s.y > h + 100) shooting = null;
        }
      }
    };

    const loop = (t: number) => {
      if (!running) return;
      draw(t);
      requestAnimationFrame(loop);
    };

    resize();
    window.addEventListener('resize', resize);

    if (reduceMotion) {
      draw(0);
      window.addEventListener('scroll', () => draw(0), { passive: true });
      window.addEventListener('resize', () => draw(0));
    } else {
      requestAnimationFrame(loop);
      // Pause when the tab is hidden to save battery.
      document.addEventListener('visibilitychange', () => {
        running = !document.hidden;
        if (running) requestAnimationFrame(loop);
      });
    }
  }
</script>
